# --- REQUIRED ---

# Salt used to derive the shared Sponsored FPC contract address.
# A 32-byte hex value (0x-prefixed), e.g. 0xabcd...1234
SPONSORED_FPC_SALT=

# Your account secret key — provided by the CTF platform.
# A 32-byte hex value (0x-prefixed), e.g. 0xabcd...1234
ACCOUNT_SECRET_KEY=

# --- OPTIONAL ---

# Wallet/account salt used for your Schnorr account.
# For test/dev you can set this to a 32-byte 0x-prefixed hex value.
# For CTF scoring, only ACCOUNT_SALT=ZERO (or empty) will be accounted for points.
ACCOUNT_SALT=ZERO

# Testnet RPC URL used by account deployment and solve scripts.
# Defaults to Aztec public testnet RPC.
TESTNET_NODE_URL=https://rpc.testnet.aztec-labs.com/

# Local sandbox RPC URL used by tests.
# Defaults to a local Aztec sandbox on port 8080.
LOCAL_NETWORK_NODE_URL=http://localhost:8080
